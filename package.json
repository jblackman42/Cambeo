{
  "name": "cambeo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Real-time multiplayer Cambeo (house-ruled Cambio)",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @cambeo/web dev",
    "dev:web": "pnpm --filter @cambeo/web dev",
    "dev:server": "pnpm --filter @cambeo/server dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cards:optimize": "node scripts/optimize-cards.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
